# ─── Honey-Pot Local Agent — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.

# Your Honey-Pot API key (set this in your deployed API's .env too)
HONEYPOT_API_KEY=your_api_key_here

# Honey-Pot API URL (use the Render URL or localhost for local mode)
HONEYPOT_URL=https://honey-pot-agent.onrender.com/honeypot/message

# ─── Telegram (get from https://my.telegram.org/apps) ──────────────────────────
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# ─── Gmail (how often to check inbox, in seconds) ──────────────────────────────
GMAIL_POLL_SECONDS=30

# ─── Android SMS (how often to check SMS inbox, in seconds) ────────────────────
SMS_POLL_SECONDS=10

# ─── Completion Watcher (how often to poll API for finished sessions, in seconds)
WATCHER_POLL_SECONDS=30
